# 可选：命令行模式 (python main.py) 使用的默认配置
# 图形界面 (streamlit run app.py) 可在页面中手动填写 API，无需此文件

# Square Access Token（从 https://developer.squareup.com/apps 获取）
# SQUARE_ACCESS_TOKEN=

# 环境: production 或 sandbox
# SQUARE_ENVIRONMENT=production

# 可选：指定门店 Location ID（留空则自动使用第一个门店）
# SQUARE_LOCATION_ID=

# 历史订单回溯天数
# HISTORY_DAYS=90

# 预测未来进货天数
# FORECAST_DAYS=30

# 安全库存系数（1.0≈84%服务水平, 1.65≈95%）
# SAFETY_STOCK_Z=1.65
